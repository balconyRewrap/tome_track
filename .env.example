# Django
SECRET_KEY=your-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_ADMIN_PATH=admin/

# Domain and HTTPS
DOMAIN_NAME=api.example.com
LETSENCRYPT_EMAIL=admin@example.com
LETSENCRYPT_STAGING=0

# Database
POSTGRES_DB=tt_db
POSTGRES_USER=tt_user
POSTGRES_PASSWORD=tt_pass
DATABASE_URL=postgres://tt_user:tt_pass@db:5432/tt_db

# Redis
REDIS_URL=redis://redis:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend (used in password reset emails)
FRONTEND_URL=http://localhost:3000

# Email for SMTP configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=your-gmail@gmail.com
SERVER_EMAIL=errors@your-domain.com
ADMIN_ERROR_EMAILS=admin1@example.com,admin2@example.com

# Admin
ALLOWED_ADMIN_IPS=127.0.0.1,127.0.0.2

# Throttle rates
ANON_THROTTLE_RATE=60/min
USER_THROTTLE_RATE=300/min
REGISTER_THROTTLE_RATE=10/hour
LOGIN_THROTTLE_RATE=5/min
PASSWORD_RESET_THROTTLE_RATE=5/hour
